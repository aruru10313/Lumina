     }
 
+    // Folia-Compat start - legacy BukkitScheduler support
+    /**
+     * Called once per global tick. Sync tasks only run inside a legacy exclusive section (all regions paused),
+     * so the expensive pause only happens on ticks where a sync task is actually due.
+     */
+    public void legacyHeartbeat() {
+        this.parsePending();
+        if (this.isReady(this.currentTick + 1)) {
+            io.papermc.paper.threadedregions.LegacyCompat.runExclusive(this::mainThreadHeartbeat);
+        } else {
+            this.mainThreadHeartbeat();
+        }
+    }
+    // Folia-Compat end - legacy BukkitScheduler support
+
     protected void addTask(final CraftTask task) {
         final CraftTask tailTask = this.tail.getAndSet(task);
         tailTask.setNext(task);
     }
 
