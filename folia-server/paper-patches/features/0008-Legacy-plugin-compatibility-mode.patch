diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 7ce9ebba8ce304d1f3f21d4f15ee5f3560d7700b..23a16fa4a8f3b3e24b65eeb345f95ecee6dd587d 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -45,6 +45,26 @@ class PaperEventManager {
         HandlerList handlers = event.getHandlers();
         RegisteredListener[] listeners = handlers.getRegisteredListeners();
 
+        // Folia-Compat start - run sync events with legacy listeners while all regions are paused
+        if (!event.isAsynchronous() && io.papermc.paper.threadedregions.LegacyCompat.ENABLED
+                && !io.papermc.paper.threadedregions.LegacyCompat.isExclusiveOwner() && hasLegacyListener(listeners)) {
+            io.papermc.paper.threadedregions.LegacyCompat.runExclusive(() -> this.dispatchEvent(event, listeners));
+            return;
+        }
+        this.dispatchEvent(event, listeners);
+    }
+
+    private static boolean hasLegacyListener(final RegisteredListener[] listeners) {
+        for (final RegisteredListener registration : listeners) {
+            if (io.papermc.paper.threadedregions.LegacyCompat.isLegacy(registration.getPlugin()) && registration.getPlugin().isEnabled()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void dispatchEvent(final Event event, final RegisteredListener[] listeners) {
+        // Folia-Compat end - run sync events with legacy listeners while all regions are paused
         for (RegisteredListener registration : listeners) {
             if (!registration.getPlugin().isEnabled()) {
                 continue;
