     protected boolean teleport0(Location location, TeleportCause cause, TeleportFlag... flags) {
         // Folia start - region threading
+        // Folia-Compat start - legacy plugins call the sync teleport; forward it to teleportAsync
+        if (io.papermc.paper.threadedregions.LegacyCompat.ENABLED) {
+            // run in the entity's own region context, so Folia's async teleport moves it between regions correctly
+            final net.minecraft.world.entity.Entity legacyHandle = this.getHandle();
+            io.papermc.paper.threadedregions.LegacyCompat.inRegionAt((net.minecraft.server.level.ServerLevel)legacyHandle.level(),
