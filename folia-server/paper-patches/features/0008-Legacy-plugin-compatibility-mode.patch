     public static void ensureMain(String reason, Runnable run) {
         if (!isMainThread()) {
+            // Folia-Compat start - run on the global region instead of the (undrained) main process queue
+            if (io.papermc.paper.threadedregions.LegacyCompat.ENABLED) {
+                io.papermc.paper.threadedregions.RegionizedServer.getInstance().addTask(() -> io.papermc.paper.threadedregions.LegacyCompat.runExclusive(run));
+                return;
+            }
+            // Folia-Compat end - run on the global region instead of the (undrained) main process queue
             if (true) throw new UnsupportedOperationException(); // Folia - region threading
             if (reason != null) {
                 MinecraftServer.LOGGER.warn("Asynchronous " + reason + "!", new IllegalStateException());
