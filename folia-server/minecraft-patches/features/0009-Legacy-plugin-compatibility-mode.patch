     private static boolean initialised;
     private static TickRegionScheduler scheduler;
 
+    // Lumina start - legacy plugins may sync-load chunks in onEnable, which needs region threads running
+    private static volatile boolean started;
+
+    public static boolean isStarted() {
+        return started;
+    }
+
+    public static synchronized void start() {
+        if (started) {
+            throw new IllegalStateException("Already started");
+        }
+        started = true;
+        getScheduler().init();
+    }
+    // Lumina end - legacy plugins may sync-load chunks in onEnable, which needs region threads running
+
     public static TickRegionScheduler getScheduler() {
         return scheduler;
     }
