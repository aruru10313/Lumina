@@ -135,6 +135,77 @@ public final class TickRegionScheduler {
         return tickThreadRunner.currentTickingTask;
     }
 
+    // Folia-Compat start - let a waiting legacy exclusive section execute another region's queued tasks inline
+    /**
+     * Runs the queued (non-tick) tasks of the given region on the current tick thread, temporarily swapping out the
+     * current thread's region context. Used while a legacy exclusive section waits for a chunk load that the target
+     * region must complete: with few tick threads, the waiting thread may be the only one able to run it.
+     * @return {@code false} if the region could not be acquired (e.g. it is ticking on another thread)
+     */
+    static boolean legacyRunRegionTasksInline(final RegionScheduleHandle handle, final BooleanSupplier canContinue) {
+        if (!(Thread.currentThread() instanceof TickThreadRunner runner) || handle.region == null) {
+            return false;
+        }
+        if (!handle.tryMarkTicking()) {
+            return false;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> savedRegion = runner.currentTickingRegion;
+        final RegionizedWorldData savedWorldData = runner.currentTickingWorldRegionizedData;
+        final SchedulerThreadPool.SchedulableTick savedTask = runner.currentTickingTask;
+        final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle savedProfiler = runner.profiler;
+        runner.currentTickingRegion = null;
+        runner.currentTickingWorldRegionizedData = null;
+        runner.currentTickingTask = null;
+        try {
+            TickRegionScheduler.setTickTask(handle);
+            TickRegionScheduler.setTickingRegion(handle.region.region);
+            try {
+                handle.runRegionTasks(canContinue);
+            } finally {
+                TickRegionScheduler.setTickTask(null);
+                TickRegionScheduler.setTickingRegion(null);
+            }
+        } finally {
+            runner.currentTickingRegion = savedRegion;
+            runner.currentTickingWorldRegionizedData = savedWorldData;
+            runner.currentTickingTask = savedTask;
+            runner.profiler = savedProfiler;
+            handle.markNotTicking();
+        }
+        return true;
+    }
+    // Folia-Compat end - let a waiting legacy exclusive section execute another region's queued tasks inline
+
+    // Folia-Compat start - run code in another region's context while all regions are paused
+    /**
+     * Executes {@code run} with the current tick thread's region context switched to {@code region}.
+     * Only valid inside a legacy exclusive section (every other region is parked), so the region's data
+     * cannot be accessed concurrently.
+     */
+    static <T> T legacyRunInRegion(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region,
+                                   final java.util.function.Supplier<T> run) {
+        if (!(Thread.currentThread() instanceof TickThreadRunner runner) || runner.currentTickingRegion == region) {
+            return run.get();
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> savedRegion = runner.currentTickingRegion;
+        final RegionizedWorldData savedWorldData = runner.currentTickingWorldRegionizedData;
+        final SchedulerThreadPool.SchedulableTick savedTask = runner.currentTickingTask;
+        final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle savedProfiler = runner.profiler;
+        runner.currentTickingRegion = region;
+        runner.currentTickingWorldRegionizedData = region.getData().getOrCreateRegionizedData(region.regioniser.world.worldRegionData);
+        runner.currentTickingTask = region.getData().getRegionSchedulingHandle();
+        runner.profiler = ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle.NO_OP_HANDLE;
+        try {
+            return run.get();
+        } finally {
+            runner.currentTickingRegion = savedRegion;
+            runner.currentTickingWorldRegionizedData = savedWorldData;
+            runner.currentTickingTask = savedTask;
+            runner.profiler = savedProfiler;
+        }
+    }
+    // Folia-Compat end - run code in another region's context while all regions are paused
+
     // Folia start - profiler
     public static ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle getProfiler() {
         final Thread currThread = Thread.currentThread();
@@ -336,6 +407,7 @@ public final class TickRegionScheduler {
             final boolean ret;
             final FoliaWatchdogThread.RunningTick runningTick = new FoliaWatchdogThread.RunningTick(tickStart, this, Thread.currentThread()); // Folia - watchdog
